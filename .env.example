# Klouds - Environment Configuration
# Copy this to .env and fill in your values.

# Server
KLOUDS_HOST=0.0.0.0
KLOUDS_PORT=8080
KLOUDS_BASE_URL=http://localhost:8080
KLOUDS_DOMAIN=localhost

# Database
DATABASE_URL=postgres://klouds:klouds@localhost:5433/klouds?sslmode=disable

# Security - CHANGE THIS! Must be at least 32 characters.
KLOUDS_SECRET_KEY=change-this-to-a-random-32-plus-char-string

# Docker
# DOCKER_HOST=unix:///var/run/docker.sock
KLOUDS_DOCKER_NETWORK=klouds-internal

# Caddy
KLOUDS_CADDY_ADMIN=http://localhost:2019

# Data
KLOUDS_DATA_DIR=./data

# Token duration (Go duration format)
KLOUDS_TOKEN_DURATION=24h

# Build timeout
KLOUDS_BUILD_TIMEOUT=10m

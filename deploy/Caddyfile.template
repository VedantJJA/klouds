# Klouds - Production Caddyfile Template
# Replace KLOUDS_DOMAIN with your actual domain.
# This file is a template; dynamic routing is also applied via Caddy JSON API.

{
    email admin@{$KLOUDS_DOMAIN}
    admin :2019

    # Automated SSL/TLS on-demand verification
    # Protects against rate limits and unauthorized cert issuance
    on_demand_tls {
        ask http://klouds-api:8080/api/tls/check
        interval 2m
        burst 5
    }
}

# Platform dashboard & API with automatic TLS
{$KLOUDS_DOMAIN} {
    # API
    handle /api/* {
        reverse_proxy klouds-api:8080
    }

    handle /health {
        reverse_proxy klouds-api:8080
    }

    # Dashboard (SvelteKit SSR)
    handle {
        reverse_proxy klouds-dashboard:3000
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
}

# Automated TLS for all hosted user applications and custom domains
*.{$KLOUDS_DOMAIN} {
    tls {
        on_demand
    }

    # Dynamic upstream resolution happens via Caddy JSON API
    respond "Service not found or starting up" 404
}
